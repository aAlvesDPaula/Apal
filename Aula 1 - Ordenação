void exibir(vector<int> &v)
{
    for (size_t i = 0; i < v.size(); i++)
        cout << v[i] << ' ';
}

bool sequencial(vector<int> &v, int chave)
{
    for (size_t i = 0; i < v.size(); i++)
        if (v[i] == chave)
            return i + 1;

    return 0;
}

int binaria(vector<int> &v, int chave)
{
    int i = 0, f = v.size() - 1;
    while (i <= f)
    {
        int m = (f - i) / 2 + i;
        if (v[m] == chave)
            return m;
        else if (v[m] > chave)
            f = m - 1;
        else if (v[m] < chave)
            i = m + 1;
        
    }
    return -1;
}
void selection(vector<int> &v)
{
    int id_menor = 0, j = 0;
    for (int j = 0; j < v.size(); j++)
    {
        for (int i = 0; i < v.size(); i++)
            if (v[i] < v[id_menor])
                id_menor = i;
        swap(v[j], v[v.size() + j - 1]);
    }
}
void BubbleSort(vector<int> &v){
    for (int j = 0; j < v.size() - 1; j++){
        bool  ordenado = true;
        for (int i = 0; i < v.size() - j; i++)
            if(v[i-1] > v[i]){
                swap(v[i-1], v[i]); 
                ordenado = false;
            }
            if(ordenado){
                // cout  << ">> iterações: " << j + 1 << endl; 
                break;}
    }
}
void insertion(vector<int> &v){
    
    for (int j = 1; j < v.size() ; j++){
        int i, atual = v[j];
        for (i = 0; i >= 0; i--){
            if(atual < v[i])
                v[i+1] = v[i];
                    else    
                        break;
            }
            v[i+1] = atual;
    }  
}


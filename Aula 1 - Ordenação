#include <bits/stdc++.h>
using namespace std;

void exibir(vector<int> &v)
{
    for (size_t i = 0; i < v.size(); i++)
        cout << v[i] << ' ';
}

bool sequencial(vector<int> &v, int chave)
{
    for (size_t i = 0; i < v.size(); i++)
        if (v[i] == chave)
            return i + 1;

    return 0;
}

int binaria(vector<int> &v, int chave)
{
    int i = 0, f = v.size() - 1;
    while (i <= f)
    {
        int m = (f - i) / 2 + i;
        if (v[m] == chave)
            return chave;
        else if (v[m] > chave)
            f = m - 1;
        else if (v[m] < chave)
            i = m + 1;

        return -1;
    }
}
void selecao(vector<int> &v)
{
    int id_menor = 0, j = 0;
    for (int j = 0; j < v.size(); j++)
    {
        for (int i = 0; i < v.size(); i++)
            if (v[i] < v[id_menor])
                id_menor = i;
        swap(v[j], v[v.size() + j - 1]);
    }
}

int main()
{

    srand(time(NULL));
    vector<int> vet;
    for (int i = 0; i <= 10; i++)
        vet.push_back(i + rand() % 100);
    exibir(vet);
    cout << endl;
    int chave = vet[4];
    cout << "Busca por " << chave << (sequencial(vet, chave) ? "" : "não") << "encontrado\n";
}
